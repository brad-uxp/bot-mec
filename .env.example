# URL a monitorear
TARGET_URL=https://bpmgob.mec.gub.uy/

# Frecuencia de chequeo (ms). 60000 = 1 minuto.
CHECK_INTERVAL_MS=60000

# Timeout de cada request (ms).
REQUEST_TIMEOUT_MS=15000

# Status HTTP máximo que se considera "arriba" (inclusive). 399 = 2xx y 3xx.
SUCCESS_STATUS_MAX=399

# Cuántos fallos consecutivos antes de declarar el sitio CAÍDO.
CONSECUTIVE_FAILURES_FOR_DOWN=2

# Avisar cuando el sitio se recupera. (true/false)
ALERT_ON_RECOVERY=true

# Avisar cuando el sitio se cae después de haber estado arriba. (true/false)
ALERT_ON_DOWN=true

# Avisar en el primer chequeo si está arriba. (true/false)
ALERT_ON_START=false

# Puerto del healthcheck HTTP (Railway lo setea automáticamente).
PORT=3000

# --- Canales de notificación (configura uno o ambos) ---

# Telegram: crea un bot con @BotFather, obtén el token, y consigue tu chat_id
# (mensaje al bot + GET https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: crea un webhook en el canal (Editar canal → Integraciones → Webhooks).
DISCORD_WEBHOOK_URL=
